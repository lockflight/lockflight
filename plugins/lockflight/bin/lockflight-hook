#!/bin/sh
# Lockflight plugin hook shim (POSIX sh; Git Bash on Windows). States:
#   1. no lockflight.yaml above the project directory  -> no-op (never block unrelated projects)
#   2. .lockflight/lockdown present and no engine       -> only reads allowed (tighten-only lockdown)
#   3. linked engine present                            -> run it (fast path, ~5 ms)
#   4. engine not restored/linked, or not trusted       -> recovery: reads and the exact restore/link command only
LOCKFLIGHT_PLUGIN_API=1
export LOCKFLIGHT_PLUGIN_API
event="$1"
# At session start the engine reports a project engine older than this plugin works with (min-engine-version, a released
# version). `read` is a shell builtin, so this starts no process.
if [ "$event" = "session-start" ] && [ -f "${0%/*}/../min-engine-version" ]; then
  IFS= read -r LOCKFLIGHT_PLUGIN_MIN_ENGINE < "${0%/*}/../min-engine-version" || true
  export LOCKFLIGHT_PLUGIN_MIN_ENGINE
  # Claude Code sources CLAUDE_ENV_FILE into the session's later Bash commands, so `lockflight doctor` run by the agent checks
  # the plugin this session loaded (also one from --plugin-dir), not only the installed one. Values that would need quoting
  # beyond single quotes are left out rather than written.
  if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
    case "$LOCKFLIGHT_PLUGIN_MIN_ENGINE" in
      *[!0-9A-Za-z.+-]*|"") ;;
      *) printf "export LOCKFLIGHT_PLUGIN_MIN_ENGINE='%s'\n" "$LOCKFLIGHT_PLUGIN_MIN_ENGINE" >> "$CLAUDE_ENV_FILE" ;;
    esac
    plugin_root="${CLAUDE_PLUGIN_ROOT:-${0%/*}/..}"
    case "$plugin_root" in
      *"'"*|*"
"*) ;;
      *) printf "export LOCKFLIGHT_PLUGIN_ROOT='%s'\n" "$plugin_root" >> "$CLAUDE_ENV_FILE" ;;
    esac
  fi
fi
# Every process costs ~10-20 ms under Git Bash, so the fast path (CLAUDE_PROJECT_DIR set, engine linked) starts none: stdin
# goes straight to the engine and the root search uses parameter expansion only. The JSON is read only when it is needed.
input=""

# json_string <path>: the string at a top-level key ("cwd") or one level down ("tool_input.command"), unescaped. Tracks
# nesting and strings, so a key nested elsewhere ({"x":{"tool_name":"Read"}}) or inside a string value never matches.
json_string() {
  printf '%s' "$input" | tr '\n\r' '  ' | awk -v want="$1" '{
    s = $0; n = length(s); depth = 0; instr = 0; buf = ""; iskey = 0
    for (i = 1; i <= n; i++) {
      c = substr(s, i, 1)
      if (instr) {
        if (c == "\\") {
          i++; e = substr(s, i, 1)
          if (e == "n") buf = buf "\n"; else if (e == "t") buf = buf "\t"; else if (e == "u") buf = buf "\\u"; else buf = buf e
          continue
        }
        if (c == "\"") {
          instr = 0
          if (iskey) { key[depth] = buf; continue }
          if (kind[depth] != "o") continue
          path = key[1]; for (d = 2; d <= depth; d++) path = path "." key[d]
          if (path == want) { printf "%s", buf; exit }
          continue
        }
        buf = buf c; continue
      }
      if (c == "\"") { instr = 1; buf = ""; iskey = (kind[depth] == "o" && expectkey[depth]); continue }
      if (c == "{") { depth++; kind[depth] = "o"; expectkey[depth] = 1; key[depth] = ""; continue }
      if (c == "[") { depth++; kind[depth] = "a"; expectkey[depth] = 0; continue }
      if (c == "}" || c == "]") { depth--; continue }
      if (c == ":") { expectkey[depth] = 0; continue }
      if (c == "," && kind[depth] == "o") expectkey[depth] = 1
    }
  }'
}

# human_expansion: whether the payload is the expansion of a typed in-session human command (/lockflight:approve, :baseline,
# :reset, :amend; any case), setting $nothing to what was not done. Such a command must never reach the agent unchecked, so it
# is blocked whenever the engine cannot judge it.
human_expansion() {
  [ "$event" = "user-prompt-expansion" ] || return 1
  name=$(json_string command_name | tr '[:upper:]' '[:lower:]')
  case "$name" in
    lockflight:approve) nothing="nothing was approved" ;;
    lockflight:baseline) nothing="nothing was accepted" ;;
    lockflight:reset) nothing="nothing was reset" ;;
    lockflight:amend) nothing="nothing was amended" ;;
    *) return 1 ;;
  esac
}

dir="${CLAUDE_PROJECT_DIR:-}"
if [ -z "$dir" ]; then
  input=$(cat)
  dir=$(json_string cwd)
fi
[ -n "$dir" ] || dir="$PWD"

# Walks up with either separator, so Windows paths ("C:\Users\x", which Git Bash file tests accept) need no cygpath.
root=""
while [ -n "$dir" ] && [ "$dir" != "." ]; do
  if [ -f "$dir/lockflight.yaml" ]; then root="$dir"; break; fi
  parent="${dir%[/\\]*}"
  [ "$parent" != "$dir" ] || break
  dir="$parent"
done
[ -n "$root" ] || exit 0

engine="$root/.lockflight/bin/lockflight"
[ -f "$engine.exe" ] && engine="$engine.exe"
# The engine runs on every hook, so it must be the copy `lockflight link` made for this user. Never a file committed to the
# repository: a cloned project could ship any program under that name. Never one another user owns: a lockflight.yaml in a
# shared folder such as /tmp would otherwise run their binary in every project below it. Ownership is not checked under Git
# Bash, which reports every file as the current user's. Never one replaced after linking: link records its SHA-256 beside it,
# and the engine must match it. Never one without a record (or with an empty one): linked by a Lockflight before 0.2.0-alpha.7,
# which wrote none, or copied in by hand; `lockflight update` links it again and writes the record. Asking git
# and hashing cost a process each (10-20 ms), so a passed check is remembered until the engine or its record changes: in .git,
# which no commit can write, or beside the engine outside a git checkout. The marker counts only while it is strictly newer than
# both, and it is dated from before the check: macOS /bin/sh compares -nt to the whole second, and Linux dates files to the
# clock tick, so an engine replaced in the same second or tick as a passed check, or while it ran, is checked again. A pass
# also holds a hard link to the very file it checked and, outside Windows, makes that file read-only; it is reused only while
# the engine is still that file (-ef) and not writable. So a file moved into place keeping an older modification time, or
# one copied over the engine with cp -p (which cannot write into a read-only file), is checked again. Where no hard link
# can be made nothing is remembered and every call checks: the modification time alone cannot tell such a replacement.
untrusted=""; untrusted_fix=""; unrecorded=""; unlocked=""
record="$root/.lockflight/bin/lockflight.sha256"
# The engine lock pins the engine by hash per platform: the git-ignored local lock of a development build first, else the
# committed one. Kept in sync with EngineLocks/EngineLock.cs by ShimSyncTests.
lockfile="$root/.lockflight/local/engine.lock"
[ -f "$lockfile" ] || lockfile="$root/.lockflight/engine.lock"
# engine_recorded: whether the record holds a hash, which it sets in $recorded (a missing or empty record holds none).
engine_recorded() {
  recorded=""; recorded_rid=""
  [ -f "$record" ] || return 1
  IFS= read -r recorded < "$record" || [ -n "$recorded" ] || return 1
  case "$recorded" in *" "*) recorded_rid="${recorded#* }"; recorded_rid="${recorded_rid%% *}" ;; esac
  recorded="${recorded%% *}"
  [ -n "$recorded" ]
}
# engine_unlocked: whether a lock exists and does not name the recorded engine for the recorded platform (no hashing: the
# record was compared with the engine already). The lock is read into its own variable; $input holds the hook payload.
engine_unlocked() {
  [ -f "$lockfile" ] || return 1
  payload="$input"; input=$(cat "$lockfile" 2>/dev/null)
  locked=""; [ -z "$recorded_rid" ] || locked=$(json_string "binaries.$recorded_rid.sha256")
  input="$payload"
  [ -z "$locked" ] || [ "$locked" != "$recorded" ]
}
# engine_differs: whether the engine's SHA-256 is not the recorded one; a missing hash tool counts as different.
engine_differs() {
  if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum < "$engine")
  elif command -v shasum >/dev/null 2>&1; then actual=$(shasum -a 256 < "$engine")
  else untrusted="neither sha256sum nor shasum is installed to compare it with the SHA-256 lockflight link recorded"; untrusted_fix="install one of them"; return 0
  fi
  actual="${actual%% *}"
  [ -z "$actual" ] || [ "$actual" != "$recorded" ]
}
if [ -x "$engine" ]; then
  # test -O and -nt are not in POSIX but dash, bash and BusyBox have them; OSTYPE is set by bash only (Git Bash: msys).
  windows=""
  # shellcheck disable=SC3028,SC3067
  case "${OSTYPE:-}" in
    msys*|cygwin*) windows=1 ;;
    *) [ -O "$engine" ] || { untrusted="it belongs to another user"; untrusted_fix="check where it came from and delete it"; } ;;
  esac
  if [ -d "$root/.git" ]; then checked="$root/.git/lockflight-engine-checked"
  elif [ -e "$root/.git" ]; then checked=""
  else checked="$root/.lockflight/bin/lockflight.checked"
  fi
  # shellcheck disable=SC3013
  if [ -z "$untrusted" ] && ! { [ -n "$checked" ] && [ "$checked" -nt "$engine" ] && [ "$engine" -ef "$checked.engine" ] \
      && { [ -n "$windows" ] || ! [ -w "$engine" ]; } && [ -s "$record" ] && [ "$checked" -nt "$record" ] \
      && { ! [ -f "$lockfile" ] || [ "$checked" -nt "$lockfile" ]; }; }; then
    # The new marker and hard link are made before the checks and moved into place only when they pass, so no hook reads them
    # early, and the link is to the file that was hashed: one renamed over the engine meanwhile is not that file.
    pending=""; held=""
    if [ -n "$checked" ] && : > "$checked.$$" 2>/dev/null; then pending="$checked.$$"; fi
    if [ -e "$root/.git" ] && git -C "$root" ls-files --error-unmatch -- "${engine#"$root"/}" >/dev/null 2>&1; then
      untrusted="it is committed to the repository"
      untrusted_fix="remove it from the repository (git rm --cached, and add .lockflight/bin/ to .gitignore)"
    else
      if [ -n "$pending" ] && ln -f "$engine" "$checked.engine.$$" 2>/dev/null; then
        held="$checked.engine.$$"
        [ -n "$windows" ] || chmod a-w "$engine" 2>/dev/null || held=""
      fi
      if ! engine_recorded; then
        [ -n "$untrusted" ] || { untrusted="it has no hash record (.lockflight/bin/lockflight.sha256): it was linked by a Lockflight older than 0.2.0-alpha.7, or copied in by hand"; unrecorded=1; }
      elif engine_differs; then
        [ -n "$untrusted" ] || { untrusted="its SHA-256 is not the one lockflight link recorded in .lockflight/bin/lockflight.sha256: it was replaced after linking"; untrusted_fix="check what replaced it"; }
      elif engine_unlocked; then
        [ -n "$untrusted" ] || { untrusted="it is not the engine ${lockfile#"$root"/} pins for this platform"; unlocked=1; }
      elif [ -n "$held" ] && mv -f "$held" "$checked.engine" 2>/dev/null && mv -f "$pending" "$checked" 2>/dev/null; then
        pending=""
      fi
    fi
    [ -z "$pending" ] || rm -f "$pending" "$checked.engine.$$"
  fi
fi
untrusted_message="lockflight: the engine at $engine was not run because $untrusted. Ask the user to $untrusted_fix, then run: dotnet tool restore && dotnet lockflight link"
# An engine without a record may be older than the plugin's min-engine-version too, and an older engine writes no record when
# linked again, so the fix is update: it installs the newest engine, re-pins the project to it and links it.
update_in_terminal="open a separate terminal window (not with \`!\` in Claude Code: that runs inside the session and is refused) and run \`~/.lockflight/bin/lockflight update\` in the project: it links the engine again and records its hash"
if [ -n "$unlocked" ]; then
  untrusted_message="lockflight: the engine at $engine was not run because $untrusted. Run exactly: ~/.lockflight/bin/lockflight link --installed (it links the locked engine when it is installed); otherwise ask the user to open a separate terminal window (not with \`!\` in Claude Code) and run \`~/.lockflight/bin/lockflight engine install\` in the project"
fi
if [ -n "$unrecorded" ]; then
  untrusted_message="lockflight: the engine at $engine was not run because $untrusted. Ask the user to $update_in_terminal"
  # The engine that would tell the person at session start is not run, so the shim does: the same fix, before any refusal.
  if [ "$event" = "session-start" ]; then
    printf '{"systemMessage":"Lockflight did not run this project%ss engine: it has no hash record (.lockflight/bin/lockflight.sha256), so the agent can only read. To fix it, %s."}\n' "'" "$update_in_terminal"
    exit 0
  fi
fi
if [ -x "$engine" ] && [ -z "$untrusted" ]; then
  # A slash command's payload is read first, so a failed engine can still be told apart from a typed human command.
  if [ "$event" = "user-prompt-expansion" ] && [ -z "$input" ]; then input=$(cat); fi
  # An engine older than this plugin does not know a newer event (TaskCompleted, say), or the hook API this plugin announces,
  # and would block every such event, Stop and SessionStart included. For every event but a tool call and a typed command
  # those refusals are let through instead (the engine prints nothing else then): the unknown event silently, the hook API
  # loudly, since none of Lockflight's checks run until the engine is updated.
  if [ "$event" != "pre-tool-use" ] && [ "$event" != "user-prompt-expansion" ]; then
    [ -n "$input" ] || input=$(cat)
    # stderr is captured to look for the refusal; stdout (the SessionStart banner, a Stop reason) goes out through fd 3 as it is.
    status=1
    { refusal=$(printf '%s' "$input" | "$engine" hook "$event" 2>&1 1>&3 3>&-); status=$?; } 3>&1
    case "$refusal" in
      *"does not know the hook event"*) exit 0 ;;
      *"the plugin speaks hook API"*)
        printf '%s\n' "$refusal" >&2
        reason=$(printf '%s' "$refusal" | tr -d '"\\' | tr '\001-\037' ' ')
        printf '{"systemMessage":"%s Lockflight%ss %s check did not run, so this event was let through."}\n' "$reason" "'" "$event"
        exit 0 ;;
    esac
    [ -z "$refusal" ] || printf '%s\n' "$refusal" >&2
    exit "${status:-1}"
  fi
  # Not `printf | exec`: in a pipeline exec only replaces the subshell and the script would fall through.
  if [ -n "$input" ]; then printf '%s' "$input" | "$engine" hook "$event"; else "$engine" hook "$event"; fi
  status=$?
  # Fail closed: a crash or any exit other than allow (0) / block (2) must not let a tool call or a human command through.
  if [ "$status" -ne 0 ] && [ "$status" -ne 2 ]; then
    if [ "$event" = "pre-tool-use" ]; then
      echo "lockflight: the engine failed (exit $status), so the tool call is blocked. Run: .lockflight/bin/lockflight doctor (from $root)" >&2
      exit 2
    fi
    if human_expansion; then
      echo "lockflight: the engine failed (exit $status), so $nothing. Run: .lockflight/bin/lockflight doctor (from $root)" >&2
      exit 2
    fi
  fi
  exit "$status"
fi

if [ "$event" = "user-prompt-expansion" ]; then
  [ -n "$input" ] || input=$(cat)
  if human_expansion; then
    if [ -n "$untrusted" ]; then echo "$untrusted_message. N${nothing#n}." >&2; exit 2; fi
    echo "lockflight: engine not installed in this project, so $nothing. Run exactly: dotnet tool restore && dotnet lockflight link, then type the command again." >&2
    exit 2
  fi
  exit 0
fi
[ "$event" = "pre-tool-use" ] || exit 0
[ -n "$input" ] || input=$(cat)
tool=$(json_string tool_name)
# Read-only tools and recovery commands: kept in sync with Hooks/ReadOnlyTools.cs and Hooks/RecoveryCommands.cs by ShimSyncTests.
case "$tool" in
  Read|Grep|Glob|LS) exit 0 ;;
esac
if [ -f "$root/.lockflight/lockdown" ]; then
  echo "lockflight: the project is in lockdown (.lockflight/lockdown exists); only reading is allowed until a human removes it." >&2
  exit 2
fi
if [ "$tool" = "Bash" ]; then
  command=$(json_string tool_input.command)
  # The ~ is compared as typed, not expanded: the agent's command line is what is matched.
  # shellcheck disable=SC2088
  case "$command" in
    "dotnet tool restore"|"dotnet tool restore && dotnet lockflight link"|"dotnet lockflight link"|"~/.lockflight/bin/lockflight link --installed"|".lockflight/bin/lockflight link --installed") exit 0 ;;
  esac
fi
if [ -n "$untrusted" ]; then
  echo "$untrusted_message" >&2
  exit 2
fi
# A development build carries a "dev" prerelease identifier (any case): 0.2.0-alpha.4.dev.<stamp>, 0.2.1-0.dev.<stamp>
# (0.2.0-dev.<stamp> before). Kept in sync with Config/EngineVersion.cs by ShimSyncTests, like the lists above. Each manifest is
# read on its own: BSD grep exits 2 for a missing file even when another one matches.
development=false
for manifest in "$root/.config/dotnet-tools.json" "$root/dotnet-tools.json"; do
  if [ -f "$manifest" ] && grep -Eiq -e '"[0-9]+\.[0-9]+\.[0-9]+-([0-9A-Za-z-]+\.)*dev[.+"]' "$manifest"; then development=true; fi
done
if [ "$development" = true ]; then
  echo "lockflight: engine not linked in this project, and the pin is a development build that no package feed has. Ask the user to run ~/.lockflight/bin/lockflight update in a separate terminal window (not with ! in Claude Code: that runs inside the session and is refused)." >&2
  exit 2
fi
echo "lockflight: engine not installed in this project (pinned in dotnet-tools.json). Run exactly: dotnet tool restore && dotnet lockflight link" >&2
exit 2
