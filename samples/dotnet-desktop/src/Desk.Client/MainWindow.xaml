<Window x:Class="Desk.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desk" Height="240" Width="360">
  <StackPanel Margin="12">
    <TextBlock Text="Quantity" />
    <TextBox x:Name="QuantityBox" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Text="Unit price" />
    <TextBox x:Name="PriceBox" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock x:Name="TotalText" Text="{Binding Total, StringFormat=Total: {0:0.00}}" FontWeight="Bold" />
    <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click" Margin="0,8,0,0" />
  </StackPanel>
</Window>
