<Project Sdk="Microsoft.NET.Sdk">
  <!-- UI automation: starts the built client. Its tests carry Category=UI, which test.stopFilter leaves out of the Stop gate
       and red/green's regression passes; CI runs them. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copies Desk.Client.exe next to the tests. -->
    <ProjectReference Include="../../src/Desk.Client/Desk.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
