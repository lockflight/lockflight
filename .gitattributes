# Normalize line endings; scripts executed by POSIX shells must stay LF even on Windows clones.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.nupkg binary
*.tsv text eol=lf
# The migration test of a CRLF manifest with a byte-order mark keeps its bytes.
engine/tests/Lockflight.Cli.Tests/Config/Migration/Cases/crlf-bom/* -text
