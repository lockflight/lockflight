Taking a project out of the solution build is structure.solution.
=== base src/Shop/Shop.csproj
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>
=== base src/Shop/Cart.cs
namespace Shop;

public sealed class Cart
{
    public int Total(int price, int count)
    {
        return price * count;
    }

    public int Discount(int total) => total / 10;
}
=== base tests/Shop.Tests/Shop.Tests.csproj
<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <ProjectReference Include="../../src/Shop/Shop.csproj" />
  </ItemGroup>
</Project>
=== base tests/Shop.Tests/CartTests.cs
namespace Shop.Tests;

public sealed class CartTests
{
    [Fact]
    public void TotalMultiplies() => Assert.Equal(6, new Cart().Total(2, 3));

    [Fact]
    public void DiscountIsATenth() => Assert.Equal(1, new Cart().Discount(10));
}
=== base Shop.sln
Microsoft Visual Studio Solution File
Project("{FAE04EC0}") = "Shop.Tests", "tests\Shop.Tests\Shop.Tests.csproj", "{1111}"
EndProject
Global
	GlobalSection(ProjectConfigurationPlatforms) = postSolution
		{1111}.Release|Any CPU.ActiveCfg = Release|Any CPU
		{1111}.Release|Any CPU.Build.0 = Release|Any CPU
	EndGlobalSection
EndGlobal
=== head Shop.sln
