A header split by #if/#else does not hide the declarations after it.
=== base src/Shop.Client/Shop.Client.csproj
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
=== base src/Shop.Client/CartClient.cs
namespace Shop.Client;

public sealed class CartClient
{
    public int Count() => 0;
}
=== base src/Shop.Client/Multi.cs
namespace Shop.Client;

public sealed class Multi
{
#if NET8_0
    public int Count()
    {
#else
    public long Count()
    {
#endif
        return 0;
    }
}
=== head src/Shop.Client/Multi.cs
namespace Shop.Client;

public sealed class Multi
{
#if NET8_0
    public int Count()
    {
#else
    public long Count()
    {
#endif
        return 0;
    }

    public int Size() => 1;
}
