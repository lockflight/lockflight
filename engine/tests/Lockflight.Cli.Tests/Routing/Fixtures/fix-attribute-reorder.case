=== head src/Shop.Api/CartsController.cs
using Microsoft.AspNetCore.Mvc;

namespace Shop.Api;

[Route("api/carts")]
[ApiController]
public sealed class CartsController(ICarts carts) : ControllerBase
{
    [HttpGet("{id}")]
    public IActionResult Get(
        int id)
    {
        Cart? cart = carts.Find(id);
        return cart is null ? NotFound() : Ok(cart);
    }
}
