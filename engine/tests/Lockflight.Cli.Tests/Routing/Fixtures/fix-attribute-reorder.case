Reordering attributes and reflowing a signature changes no declaration.
=== base src/Shop.Api/Shop.Api.csproj
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
</Project>
=== base src/Shop.Api/CartsController.cs
using Microsoft.AspNetCore.Mvc;

namespace Shop.Api;

[ApiController]
[Route("api/carts")]
public sealed class CartsController(ICarts carts) : ControllerBase
{
    [HttpGet("{id}")]
    public IActionResult Get(int id)
    {
        Cart? cart = carts.Find(id);
        return cart is null ? NotFound() : Ok(cart);
    }
}
