Without the analyzer the files are not exact: api.publicMember still fires beside api.publicApiFile.
=== base src/Shop.Client/Shop.Client.csproj
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
=== base src/Shop.Client/CartClient.cs
namespace Shop.Client;

public sealed class CartClient
{
    public int Count() => 0;
}
=== base src/Shop.Client/PublicAPI.Shipped.txt
#nullable enable
Shop.Client.CartClient
Shop.Client.CartClient.CartClient() -> void
Shop.Client.CartClient.Count() -> int
=== base src/Shop.Client/PublicAPI.Unshipped.txt
#nullable enable
=== head src/Shop.Client/CartClient.cs
namespace Shop.Client;

public sealed class CartClient
{
    public int Count() => 0;

    public int Total() => 0;
}
=== head src/Shop.Client/PublicAPI.Unshipped.txt
#nullable enable
Shop.Client.CartClient.Total() -> int
