A new public member in a packable project is api.publicMember.
=== base src/Shop.Client/Shop.Client.csproj
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>
=== base src/Shop.Client/CartClient.cs
namespace Shop.Client;

public sealed class CartClient
{
    public int Count() => 0;
}
=== head src/Shop.Client/CartClient.cs
namespace Shop.Client;

public sealed class CartClient
{
    public int Count() => 0;

    public int Total() => 0;
}
